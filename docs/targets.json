{
  "$comment": [
    "Build targets: the single source of truth for the page (docs/configure.js), the workflow",
    "(scripts/targets.py) and the NuGet packer. Platform and architecture ids contain no '-'.",
    "platform: label, nuget (NuGet id suffix for several RIDs), toolchain (scripts/platforms/",
    "  <toolchain>.sh, default: the platform id), tls (https protocol available),",
    "  linkage (allowed linkage options of the archive formats, default all; NuGet / AAR need",
    "  'shared'), programs (false: ffmpeg / ffprobe cannot be built), xcframework (true: can be",
    "  part of an XCFramework, whose pseudo platform 'apple' takes '<platform>_<arch>' targets).",
    "arch: label, rid (NuGet runtime identifier), runner, container, unavailable (library",
    "  toggle ids of docs/configure.js that cannot be built), merge (built from these archs",
    "  and merged with lipo; not offered for NuGet)."
  ],
  "platforms": {
    "linux": {
      "label": "Linux",
      "nuget": "linux",
      "tls": false,
      "archs": {
        "x86_64": { "label": "x86_64", "rid": "linux-x64", "runner": "ubuntu-latest", "container": "quay.io/pypa/manylinux_2_28_x86_64" },
        "x86": { "label": "x86 (32-bit)", "rid": "linux-x86", "runner": "ubuntu-latest", "container": "ubuntu:20.04", "unavailable": ["svtav1"] },
        "arm64": { "label": "arm64 (AArch64)", "rid": "linux-arm64", "runner": "ubuntu-24.04-arm", "container": "quay.io/pypa/manylinux_2_28_aarch64" },
        "armv7": { "label": "armv7 (ARM 32-bit)", "rid": "linux-arm", "runner": "ubuntu-latest", "container": "ubuntu:20.04", "unavailable": ["svtav1"] },
        "armel": { "label": "armel (ARMv5TE, soft-float)", "rid": "linux-armel", "runner": "ubuntu-latest", "container": "ubuntu:20.04", "unavailable": ["svtav1"] },
        "ppc64le": { "label": "ppc64le (POWER8+)", "rid": "linux-ppc64le", "runner": "ubuntu-latest", "container": "ubuntu:20.04", "unavailable": ["svtav1"] },
        "s390x": { "label": "s390x (IBM Z)", "rid": "linux-s390x", "runner": "ubuntu-latest", "container": "ubuntu:20.04", "unavailable": ["svtav1"] },
        "riscv64": { "label": "riscv64 (RV64GC)", "rid": "linux-riscv64", "runner": "ubuntu-latest", "container": "ubuntu:20.04", "unavailable": ["svtav1"] },
        "mips64el": { "label": "mips64el (MIPS64r2)", "rid": "linux-mips64el", "runner": "ubuntu-latest", "container": "ubuntu:20.04", "unavailable": ["svtav1"] },
        "mipsel": { "label": "mipsel (MIPS32r2)", "rid": "linux-mipsel", "runner": "ubuntu-latest", "container": "ubuntu:20.04", "unavailable": ["svtav1"] },
        "loongarch64": { "label": "loongarch64 (LA64)", "rid": "linux-loongarch64", "runner": "ubuntu-latest", "container": "ubuntu:24.04", "unavailable": ["svtav1"] }
      }
    },
    "macos": {
      "label": "macOS",
      "xcframework": true,
      "nuget": "osx",
      "tls": true,
      "archs": {
        "x86_64": { "label": "x86_64 (Intel)", "rid": "osx-x64", "runner": "macos-15-intel" },
        "arm64": { "label": "arm64 (Apple Silicon)", "rid": "osx-arm64", "runner": "macos-15" },
        "universal": { "label": "Universal (fat binary)", "merge": ["x86_64", "arm64"] }
      }
    },
    "windows": {
      "label": "Windows",
      "nuget": "win",
      "tls": true,
      "archs": {
        "x86_64": { "label": "x86_64", "rid": "win-x64", "runner": "ubuntu-latest" },
        "x86": { "label": "x86 (32-bit)", "rid": "win-x86", "runner": "ubuntu-latest", "unavailable": ["svtav1"] },
        "arm64": { "label": "arm64 (AArch64)", "rid": "win-arm64", "runner": "ubuntu-latest" }
      }
    },
    "android": {
      "label": "Android",
      "nuget": "android",
      "tls": false,
      "archs": {
        "arm64": { "label": "arm64-v8a", "rid": "android-arm64", "runner": "ubuntu-latest" },
        "armv7": { "label": "armeabi-v7a", "rid": "android-arm", "runner": "ubuntu-latest", "unavailable": ["svtav1"] },
        "x86_64": { "label": "x86_64", "rid": "android-x64", "runner": "ubuntu-latest" },
        "x86": { "label": "x86", "rid": "android-x86", "runner": "ubuntu-latest", "unavailable": ["svtav1"] }
      }
    },
    "ios": {
      "label": "iOS",
      "xcframework": true,
      "nuget": "ios",
      "toolchain": "apple",
      "tls": true,
      "linkage": ["static"],
      "programs": false,
      "archs": {
        "arm64": { "label": "arm64 (device)", "rid": "ios-arm64", "runner": "macos-15" },
        "sim_arm64": { "label": "arm64 (Simulator)", "rid": "iossimulator-arm64", "runner": "macos-15" },
        "sim_x86_64": { "label": "x86_64 (Simulator)", "rid": "iossimulator-x64", "runner": "macos-15" },
        "sim_universal": { "label": "Universal Simulator (arm64 + x86_64)", "merge": ["sim_arm64", "sim_x86_64"] }
      }
    },
    "tvos": {
      "label": "tvOS",
      "xcframework": true,
      "nuget": "tvos",
      "toolchain": "apple",
      "tls": true,
      "linkage": ["static"],
      "programs": false,
      "archs": {
        "arm64": { "label": "arm64 (device)", "rid": "tvos-arm64", "runner": "macos-15" },
        "sim_arm64": { "label": "arm64 (Simulator)", "rid": "tvossimulator-arm64", "runner": "macos-15" },
        "sim_x86_64": { "label": "x86_64 (Simulator)", "rid": "tvossimulator-x64", "runner": "macos-15" },
        "sim_universal": { "label": "Universal Simulator (arm64 + x86_64)", "merge": ["sim_arm64", "sim_x86_64"] }
      }
    },
    "visionos": {
      "label": "visionOS",
      "xcframework": true,
      "nuget": "visionos",
      "toolchain": "apple",
      "tls": false,
      "linkage": ["static"],
      "programs": false,
      "archs": {
        "arm64": { "label": "arm64 (device)", "rid": "visionos-arm64", "runner": "macos-15" },
        "sim_arm64": { "label": "arm64 (Simulator)", "rid": "visionossimulator-arm64", "runner": "macos-15" }
      }
    },
    "maccatalyst": {
      "label": "Mac Catalyst",
      "xcframework": true,
      "nuget": "maccatalyst",
      "toolchain": "apple",
      "tls": false,
      "archs": {
        "arm64": { "label": "arm64 (Apple Silicon)", "rid": "maccatalyst-arm64", "runner": "macos-15" },
        "x86_64": { "label": "x86_64 (Intel)", "rid": "maccatalyst-x64", "runner": "macos-15" },
        "universal": { "label": "Universal (fat binary)", "merge": ["arm64", "x86_64"] }
      }
    },
    "freebsd": {
      "label": "FreeBSD",
      "nuget": "freebsd",
      "tls": false,
      "archs": {
        "x86_64": { "label": "x86_64 (amd64)", "rid": "freebsd-x64", "runner": "ubuntu-latest" },
        "arm64": { "label": "arm64 (aarch64)", "rid": "freebsd-arm64", "runner": "ubuntu-latest" }
      }
    },
    "wasm": {
      "label": "WebAssembly (Emscripten)",
      "nuget": "browser",
      "tls": false,
      "linkage": ["static"],
      "programs": false,
      "archs": {
        "wasm32": { "label": "wasm32", "rid": "browser-wasm", "runner": "ubuntu-latest", "unavailable": ["x265", "svtav1", "dav1d", "libass"] }
      }
    }
  }
}
